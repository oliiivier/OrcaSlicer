{
  "description": "Read-only printer tools on the real printer connected through Snapmaker Connect.",
  "confirm": "no",
  "tags": [
    "printer"
  ],
  "steps": [
    {
      "call": "get_printer",
      "args": {
        "action": "status"
      },
      "expect": {
        "connected": true,
        "toolheads": "$any"
      }
    },
    {
      "call": "get_printer",
      "args": {
        "action": "snapshot"
      },
      "image": true
    },
    {
      "call": "get_printer",
      "args": {
        "action": "watch",
        "until": "state_change",
        "timeout_s": 10
      },
      "expect": {
        "event": "$any"
      }
    },
    {
      "call": "control_printer",
      "args": {
        "action": "unload_filament",
        "toolheads": [
          1
        ]
      },
      "error": true,
      "error_contains": "printer control is disabled"
    }
  ]
}
