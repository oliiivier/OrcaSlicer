        "action": "retraction",
        "start": 0,
        "end": 2,
        "step": 0.1
      },
      "expect": {
        "done": true
      }
    },
    {
      "call": "calibrate",
      "args": {
        "action": "max_volumetric_speed",
        "start": 5,
        "end": 20,
        "step": 0.5
      },
      "expect": {
        "done": true
      }
    },
    {
      "call": "calibrate",
      "args": {
        "action": "vfa",
        "start": 40,
        "end": 200,
        "step": 10
      },
      "expect": {
        "done": true
      }
    },
    {
      "call": "calibrate",
      "args": {
        "action": "pressure_advance",
        "method": "tower",
        "start": 0,
        "end": 0.1,
        "step": 0.002
      },
      "expect": {
        "done": true
      }
    },
    {
      "call": "calibrate",
      "args": {
        "action": "flow",
        "method": "classic",
        "pass": 1
      },
      "expect": {
        "done": true
