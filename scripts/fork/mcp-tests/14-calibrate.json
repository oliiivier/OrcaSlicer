    },
    {
      "call": "calibrate",
      "args": {
        "action": "temperature",
        "start": 230,
        "end": 190
      },
      "expect": {
        "done": true,
        "project": {
          "objects": "$any"
        }
      }
    },
    {
      "call": "get_issues",
      "args": {},
      "expect": {
        "summary": "$any"
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "new"
      },
      "expect": {
        "done": true
      }
    }
  ]
