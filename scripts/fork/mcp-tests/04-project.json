{
  "description": "Project files: new, import, export and save to a path, open, view and slice.",
  "confirm": "yes",
  "steps": [
    {
      "call": "edit_project",
      "args": {
        "action": "new"
      },
      "expect": {
        "done": true
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "import",
        "paths": [
          "${MODELS}/OrcaToleranceTest.stl"
        ],
        "reason": "bench"
      },
      "expect": {
        "done": true,
        "added": [
          {
            "index": 1
          }
        ]
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "import",
        "paths": [
          "relative.stl"
        ]
      },
      "error": true
    },
    {
      "call": "edit_project",
      "args": {
        "action": "import",
        "paths": [
          "${MODELS}/missing.stl"
        ]
      },
      "error": true
    },
    {
      "call": "get_project",
      "args": {},
      "expect": {
        "objects": [
          {
            "index": 1,
            "plate": 1
          }
        ]
      }
    },
    {
      "call": "get_view",
      "args": {
        "action": "model",
        "view": "iso",
        "size": 256
      },
      "image": true
    },
    {
      "call": "slice",
      "args": {},
      "expect": {
        "sliced": true,
        "plate": 1,
        "print_time_s": "$any"
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "export",
        "format": "gcode",
        "path": "${MODELS}/plate.gcode"
      },
      "expect": {
        "done": true,
        "file": "${MODELS}/plate.gcode"
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "export",
        "format": "gcode",
        "path": "${MODELS}/plate.gcode"
      },
      "error": true,
      "error_contains": "already exists"
    },
    {
      "call": "edit_project",
      "args": {
        "action": "export",
        "format": "gcode",
        "path": "${MODELS}/plate.gcode",
        "overwrite": true
      },
      "expect": {
        "done": true
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "export",
        "format": "sliced_3mf",
        "path": "${MODELS}/plate.gcode.3mf"
      },
      "expect": {
        "done": true
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "export",
        "format": "stl",
        "path": "/nonexistent-folder/x.stl"
      },
      "error": true
    },
    {
      "call": "edit_project",
      "args": {
        "action": "export",
        "format": "stl",
        "path": "${MODELS}/objects.obj"
      },
      "error": true,
      "error_contains": "must end with .stl"
    },
    {
      "call": "edit_project",
      "args": {
        "action": "export",
        "format": "stl",
        "path": "${MODELS}/objects.stl"
      },
      "expect": {
        "done": true
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "import",
        "paths": [
          "${MODELS}/objects.stl"
        ]
      },
      "expect": {
        "done": true,
        "added": [
          {
            "index": 2
          }
        ]
      },
      "note": "the exported STL reads back"
    },
    {
      "call": "edit_project",
      "args": {
        "action": "save",
        "path": "${MODELS}/bench-project.3mf"
      },
      "expect": {
        "done": true,
        "file": "${MODELS}/bench-project.3mf"
      }
    },
    {
      "call": "get_project",
      "args": {},
      "expect": {
        "project_name": "bench-project",
        "objects": [
          {
            "index": 2
          }
        ]
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "new"
      },
      "expect": {
        "done": true
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "open",
        "path": "${MODELS}/bench-project.3mf"
      },
      "expect": {
        "done": true,
        "project": {
          "objects": [
            "OrcaToleranceTest.stl"
          ]
        }
      }
    },
    {
      "call": "edit_project",
      "args": {
        "action": "save"
      },
      "expect": {
        "done": true,
        "file": "${MODELS}/bench-project.3mf"
      },
      "note": "to its own file"
    },
    {
      "call": "get_view",
      "args": {},
      "image": true,
      "note": "default action"
    },
    {
      "call": "get_docs",
      "args": {
        "action": "nope"
      },
      "error": true,
      "error_contains": "'action' must be one of"
    },
    {
      "call": "edit_project",
      "args": {
        "action": "open",
        "path": "${MODELS}/nothing.3mf"
      },
      "error": true
    },
    {
      "call": "edit_project",
      "args": {
        "action": "export",
        "format": "pdf"
      },
      "error": true
    },
    {
      "call": "edit_project",
      "args": {
        "action": "new"
      },
      "expect": {
        "done": true
      }
    }
  ]
}
