{
  "description": "Notes folder of the disposable configuration.",
  "confirm": "yes",
  "steps": [
    {
      "call": "notes",
      "args": {
        "action": "list"
      },
      "expect": {
        "writable": true,
        "notes": "$any"
      }
    },
    {
      "call": "notes",
      "args": {
        "action": "write",
        "name": "bench/first.md",
        "content": "# First\nhello",
        "mode": "create"
      },
      "expect": {
        "name": "bench/first.md",
        "created": true
      }
    },
    {
      "call": "notes",
      "args": {
        "action": "write",
        "name": "bench/first.md",
        "content": "again",
        "mode": "create"
      },
      "error": true
    },
    {
      "call": "notes",
      "args": {
        "action": "write",
        "name": "bench/first.md",
        "content": "world",
        "mode": "append"
      },
      "expect": {
        "created": false
      }
    },
    {
      "call": "notes",
      "args": {
        "action": "read",
        "name": "bench/first.md"
      },
      "expect": {
        "content": "# First\nhello\nworld"
      }
    },
    {
      "call": "notes",
      "args": {
        "action": "list"
      },
      "expect": {
        "notes": [
          {
            "name": "bench/first.md"
          }
        ]
      }
    },
    {
      "call": "notes",
      "args": {
        "action": "read",
        "name": "../outside.md"
      },
      "error": true
    }
  ]
}
